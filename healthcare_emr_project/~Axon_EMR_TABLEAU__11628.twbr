      </column>
      <column caption='Collection Rate' datatype='real' default-format='p0%' name='[Calculation_0956908840992768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([Outstanding ($)]) / SUM([Amount Billed ($)])' />
      </column>
      <column caption='Completion Rate' datatype='real' default-format='p0%' name='[Calculation_0956908841172993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Visit Status]=&apos;Completed&apos; THEN [Visit ID] END) / COUNTD([Visit ID])' />
      </column>
      <column caption='Denial Rate' datatype='real' default-format='p0%' name='[Calculation_0956908841349122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Claim Status]=&apos;Denied&apos; THEN [Claim ID] END) / COUNTD([Claim ID])' />
