  <worksheets>
    <worksheet name='Denial Reasons'>
      <table>
        <view>
          <datasources>
            <datasource caption='visit+ (axon_emr)' name='federated.1yvpl1z17he4os1aivjx017b2z9q' />
          </datasources>
          <datasource-dependencies datasource='federated.1yvpl1z17he4os1aivjx017b2z9q'>
            <column datatype='string' name='[Claim ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Denial Reason]' role='dimension' type='nominal' />
            <column datatype='date' name='[Visit Date]' role='dimension' type='ordinal' />
            <column-instance column='[Claim ID]' derivation='Count' name='[cnt:Claim ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Visit Date]' derivation='Month' name='[mn:Visit Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Denial Reason]' derivation='None' name='[none:Denial Reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[Visit Date]' derivation='Year' name='[yr:Visit Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1yvpl1z17he4os1aivjx017b2z9q].[none:Denial Reason:nk]'>
            <groupfilter count='5' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNT([Claim ID])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                  <groupfilter function='member' level='[none:Denial Reason:nk]' member='&quot;Coding Error&quot;' />
